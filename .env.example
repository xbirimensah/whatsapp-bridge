# Bearer token for the REST API (auto-generated on first boot if empty)
API_TOKEN=

# REST API host/port (defaults: 127.0.0.1 / 8080)
HOST=127.0.0.1
PORT=8080

# Optional: HTTP endpoint to POST inbound messages to.
# Leave empty to disable the webhook.
WEBHOOK_URL=

# Optional: bearer token sent as Authorization header to WEBHOOK_URL.
WEBHOOK_TOKEN=

# Optional: OpenAI API key. When set, inbound voice notes (audio messages) are
# transcribed via Whisper and the transcript is folded into the message body
# wherever the API is read (web UI, MCP, /v1/messages). Audio bodies are
# uploaded to api.openai.com — leave blank to disable.
OPENAI_API_KEY=

# Optional: local voice-note transcription with mlx-whisper (Apple Silicon).
# Point this at a Python that has `mlx-whisper` installed (ffmpeg must be on
# PATH). When set, voice notes are transcribed on this machine first and OpenAI
# is only the fallback. See scripts/transcribe_local.py.
TRANSCRIBE_LOCAL_PYTHON=
# Optional: Hugging Face model repo, default mlx-community/whisper-large-v3-turbo.
TRANSCRIBE_LOCAL_MODEL=

# Optional: your own "message yourself" chat, comma-separated JIDs. Messages you
# type there are forwarded to WEBHOOK_URL too, so an agent can take orders.
# Needed for the task pipeline (docs/tasks.md).
WA_SELF_CHAT_JIDS=

# Set to 1 ONLY after putting whatsapp-bridge behind a TLS-terminating reverse proxy
# (e.g. Caddy). Without this flag, the daemon refuses to bind a non-loopback HOST.
WA_ALLOW_PUBLIC=

# API rate limits (all optional; 0 disables a limit). Defaults keep programmatic
# send velocity under WhatsApp's observed spam thresholds - see README
# "Rate limiting". Reads are never limited; phone-typed messages unaffected.
RATE_LIMIT_SEND_PER_MIN=20
RATE_LIMIT_SEND_PER_HOUR=60
RATE_LIMIT_CHECK_PER_MIN=300
RATE_LIMIT_SEARCH_PER_MIN=60

# Autoreply context: recent messages from the active chat. Set 0 to disable,
# or any integer from 1–500 (for example 25, 50, or 100). Default: 50.
AUTOREPLY_HISTORY_MESSAGE_LIMIT=50

# Private second-brain retrieval: returns only a few relevant pgvector/FTS hits.
# Requires AUTOREPLY_SECOND_BRAIN_ROOT to point at your second-brain sync project.
AUTOREPLY_PERSONAL_CONTEXT_LIMIT=3
AUTOREPLY_PERSONAL_CONTEXT_MAX_CHARS=2400

# --- Autoreply LLM provider ---------------------------------------------------
# The drafter is provider-agnostic. Switch at runtime without a restart via
# `npm run autoreply:model` or the HTTP /model routes; these env values are the
# boot defaults when data/autoreply/model-config.json is absent.
#
# Providers:
#   claude-cli - local `claude` CLI, uses its own login (no API key needed)
#   codex-cli  - local `codex` CLI, uses its ChatGPT login (no API key needed)
#   anthropic  - Anthropic Messages API (ANTHROPIC_API_KEY or AUTOREPLY_LLM_API_KEY)
#   openai     - any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, Ollama,
#                LM Studio, ... (OPENAI_API_KEY or AUTOREPLY_LLM_API_KEY; local
#                endpoints need no key)
AUTOREPLY_LLM_PROVIDER=claude-cli
AUTOREPLY_LLM_MODEL=

# Provider-specific keys. AUTOREPLY_LLM_API_KEY is the provider-agnostic
# fallback used when the specific key is unset. Keys are re-read from .env on
# every draft, so adding one does not require a restart.
ANTHROPIC_API_KEY=
AUTOREPLY_LLM_API_KEY=

# OpenAI-compatible base URL override (e.g. http://127.0.0.1:11434/v1 for
# Ollama). https is required for non-local hosts.
AUTOREPLY_LLM_BASE_URL=
